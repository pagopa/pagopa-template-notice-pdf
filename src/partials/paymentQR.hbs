<div class="payment-details unique-grid-cell">
    <div class="qrcode-area">
        {{!-- `title` is set by the infraction notice, which renders two QR codes
        (discounted / reduced amount) that must not share the same alt text --}}
        <img class="payment-qrcode" src="{{genQrCode this.qrCode this.tempPath}}"
            alt="{{__ 'paymentData.qrCode' lng=@root.metadata.language}}, {{#if title}}{{__ title lng=@root.metadata.language}}{{else}}{{__ 'paymentData.type.withoutExpiryDate' lng=@root.metadata.language}}{{/if}}" />
        {{{languageHandler
        "paymentData.instructions.qrCode.singlePayment"
        classContainer="mt-small"
        classPrimaryLang="body"
        classSecondaryLang="body muted"
        align="vertical"
        }}}
    </div>
    <div class="payment-details-data">
        <div class="payment-details-data-1st-block">

            <div class="grid-cell-span-1">
                <dl class="data-key-value" role="list">
                    <div class="kv-item" role="listitem">
                        <dt>
                            {{{languageHandler "paymentData.recipient" classSecondaryLang="muted"}}}
                        </dt>
                        <dd class="forcedCapitalCase">{{lowercase debtor.fullName}}</dd>
                    </div>
                </dl>
            </div>

            <dl class="data-key-value-inline-monospaced align-right valign-start" role="list">
                <div class="kv-item" role="listitem">
                    <dt>Euro</dt>
                    <dd>{{this.amount}}</dd>
                </div>
            </dl>

            <div class="grid-cell-span-2">
                <dl class="data-key-value" role="list">
                    <div class="kv-item" role="listitem">
                        <dt>
                            {{{languageHandler "paymentData.payee" classSecondaryLang="muted"}}}
                        </dt>
                        <dd>{{payee.name}}</dd>
                    </div>
                </dl>
            </div>

            <div class="grid-cell-span-2">
                <dl class="data-key-value" role="list">
                    <div class="kv-item" role="listitem">
                        <dt>
                            {{{languageHandler "paymentData.description" classSecondaryLang="muted"}}}
                        </dt>
                        <dd>{{notice.subject}}</dd>
                    </div>
                </dl>
            </div>
        </div>

        <div class="payment-details-data-2nd-block">

            <div class="grid-cell-span-2">
                <dl class="data-key-value-monospaced" role="list">
                    <div class="kv-item" role="listitem">
                        <dt>
                            {{{languageHandler "paymentData.cbillCode" classSecondaryLang="muted" classContainer="dense"
                            align="vertical"}}}
                        </dt>
                        <dd>{{notice.cbillCode}}</dd>
                    </div>
                </dl>
            </div>

            <div class="grid-cell-span-4">
                <dl class="data-key-value-monospaced" role="list">
                    <div class="kv-item" role="listitem">
                        <dt>
                            {{{languageHandler "paymentData.refNumber" classSecondaryLang="muted" classContainer="dense"
                            align="vertical"}}}
                        </dt>
                        <dd>{{splitAndSpace this.refNumber}}</dd>
                    </div>
                </dl>
            </div>

            <div class="grid-cell-span-2 align-right">
                <dl class="data-key-value-monospaced" role="list">
                    <div class="kv-item" role="listitem">
                        <dt>
                            {{{languageHandler "paymentData.payeeTaxCode" classSecondaryLang="muted" classContainer="dense"
                            align="vertical"}}}
                        </dt>
                        <dd>{{payee.taxCode}}</dd>
                    </div>
                </dl>
            </div>

        </div>
    </div>
</div>